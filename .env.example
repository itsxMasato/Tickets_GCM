PORT=3000
NODE_ENV=development
SESSION_SECRET=cambiar-en-produccion-largo-y-aleatorio
DB_PATH=./data/tickets.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- SQL Server (TypeORM) ---
# Resueltos por src/orm/env.js. Si MSSQL_* no están definidos, hace fallback a DB_*.
# Típicamente DB_* viene del setup legacy de la app y se reusa acá sin duplicar.
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true
MSSQL_POOL_MAX=10
ORM_SYNCHRONIZE=false
ORM_LOGGING=false
