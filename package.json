{
  "name": "tickets-gcm",
  "version": "0.2.0",
  "private": true,
  "description": "Sistema de tickets interno GCM con flujo por áreas (supervisor_campo → SAC → admin_area → jefe_inmediato)",
  "author": "Miguel Flores",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "pnpm run dev:all",
    "dev:server": "nodemon src/server.js",
    "dev:css": "tailwindcss -i ./client/styles.css -o ./public/css/styles.css --watch",
    "dev:client": "vite",
    "dev:all": "concurrently -n css,server,client -c blue,green,magenta \"pnpm dev:css\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "build:css": "tailwindcss -i ./client/styles.css -o ./public/css/styles.css --minify",
    "build:client": "vite build",
    "build": "pnpm build:css && pnpm build:client",
    "start": "node src/server.js",
    "orm:smoke": "node scripts/orm-smoke.js",
    "smoke:multitenant": "node scripts/smoke-multitenant.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "tickets",
    "gcm",
    "sac",
    "soporte"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-sqlite3": "^0.9.16",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mssql": "^12.5.5",
    "multer": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "typeorm": "^1.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0"
  }
}
