# Variables de entorno para producción (Render.com)
# Este archivo es DOCUMENTATIVO — Render no lo lee. Setear cada variable
# en el dashboard: https://dashboard.render.com → tickets-gcm-api → Environment

# ─── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT lo asigna Render automáticamente (no setear)

# ─── Sesión ─────────────────────────────────────────────────────────────
# SESSION_SECRET se genera automáticamente con `generateValue: true` en
# render.yaml. Si querés setearlo manual, debe ser un string aleatorio largo.
SESSION_SECRET=

# ─── Firebase Admin ─────────────────────────────────────────────────────
# Copiar el contenido COMPLETO de keys/service-account.json en UNA línea
# (sin saltos de línea ni espacios). En Render dashboard:
#   Environment → Add Environment Variable → FIREBASE_SERVICE_ACCOUNT
#   Value: {"type":"service_account","project_id":"ticketsgcm",...}
FIREBASE_SERVICE_ACCOUNT=

FIREBASE_PROJECT_ID=ticketsgcm

# ─── CORS ───────────────────────────────────────────────────────────────
# Dominio del frontend que puede hacer requests con credentials.
# En desarrollo usar http://localhost:5173 (vite dev server).
ALLOWED_ORIGIN=https://ticketsgcm.netlify.app

# ─── Frontend (Netlify) ─────────────────────────────────────────────────
# Seteado en Netlify dashboard, NO en Render:
#   VITE_API_BASE_URL=https://tickets-gcm-api.onrender.com
