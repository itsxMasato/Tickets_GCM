data/
uploads/*
!uploads/.gitkeep
.env
keys/
public/css/styles.css
# Vite build output — regenerable con `pnpm build`. No se commitea el HTML
# ni los assets con hash; los assets originales de runtime viven en public/
# (img/, videos/, css/) y se sirven con express.static.
public/dist/

# Output del build de Netlify (netlify.toml: publish = "dist"). Netlify lo
# reconstruye desde cero en cada deploy vía `pnpm run build`; no hace falta
# commitearlo, y tenerlo commiteado ya había dejado una carpeta dist/dist/
# duplicada y desactualizada en el repo.
/dist/
*.log
.DS_Store
