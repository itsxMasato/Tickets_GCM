# Vite build output — regenerable con `pnpm build`. No se commitea el HTML
# ni los assets con hash; los assets originales de runtime viven en public/
# (img/, videos/, css/) y se sirven con express.static.
public/dist/

# Output del build de Vite (`pnpm run build`, ver vite.config.js `outDir`).
# Render lo reconstruye desde cero en cada deploy; no hace falta commitearlo,
# y tenerlo commiteado ya había dejado una carpeta dist/dist/ duplicada y
# desactualizada en el repo.
/dist/
*.log
.DS_Store
